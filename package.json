{
    "name": "ai-history-show",
    "version": "0.1.0",
    "private": true,
    "description": "Interactive AI history exhibition screen application.",
    "scripts": {
        "start": "npm run start:static",
        "start:static": "node scripts/static-server.js",
        "start:admin": "node manage/server.js",
        "start:audio-review": "node audio-review/server.js",
        "start:demo": "node scripts/static-server.js --host 127.0.0.1 --port 8000",
        "generate": "node scripts/generate-archive-data.js && npm run generate:thumbnails",
        "normalize:asset-order": "node scripts/normalize-variant-asset-order.js --write",
        "generate:archive": "node scripts/generate-archive-data.js && npm run generate:thumbnails",
        "generate:gaming-media": "node scripts/generate-gaming-media.mjs",
        "generate:logistello-gif": "node scripts/generate-logistello-game-gif.mjs",
        "generate:game-videos": "python3 scripts/game-evolution/render_game_record.py",
        "generate:paper-case-videos": "python3 scripts/game-evolution/render_paper_case.py",
        "generate:dialogue-audio": "node scripts/audio/generate-dialogue-audio.mjs",
        "audio:workflow": "node scripts/audio/audio-pipeline.mjs",
        "audio:status": "node scripts/audio/audio-pipeline.mjs status",
        "audio:review": "node scripts/audio/audio-pipeline.mjs review",
        "audio:release": "node scripts/audio/audio-pipeline.mjs release",
        "audio:revision": "node scripts/audio/audio-pipeline.mjs",
        "audio:source:build-complete-original": "node scripts/audio/build-complete-original-revisions.mjs",
        "audio:review:build": "node scripts/audio/build-audio-review-page-data.mjs",
        "audio:review:token": "node audio-review/token-cli.js",
        "audio:review:insights": "node .agents/skills/audio-review-insights/scripts/query-audio-reviews.mjs",
        "audio:legacy:plan:build": "node scripts/audio/build-audio-editorial-plan.mjs",
        "audio:legacy:plan:validate": "node scripts/audio/validate-audio-editorial-plan.mjs",
        "audio:legacy:scripts:build": "node scripts/audio/build-audio-story-scripts.mjs",
        "audio:legacy:scripts:validate": "node scripts/audio/validate-audio-story-scripts.mjs",
        "audio:legacy:scripts:dry-run": "node scripts/audio/dry-run-audio-story-scripts.mjs",
        "audio:legacy:base:generate": "node scripts/audio/generate-audio-story-assets.mjs",
        "audio:legacy:base:validate": "node scripts/audio/validate-audio-story-assets.mjs",
        "audio:legacy:samples:audit": "node scripts/audio/audit-audio-story-samples.mjs",
        "audio:legacy:release:finalize": "node scripts/audio/finalize-audio-story-release.mjs",
        "generate:event-pack": "node scripts/generate-event-markdown-pack.js",
        "generate:event-pack:images": "node scripts/generate-event-markdown-pack.js --download-remote",
        "generate:thumbnails": "node scripts/generate-image-thumbnails.js",
        "build:static": "node scripts/build-static-site.js",
        "lint": "eslint .",
        "format": "prettier --write \".agents/skills/**/*.{md,mjs,yaml}\" \"audio/**/*.json\" \"audio-review/**/*.{js,json,md}\" \"manage/**/*.js\" \"shared/**/*.js\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.js\" \"tools/audio-review-console/*.{html,css,js}\" \".github/**/*.yml\" \"*.yml\" \"*.json\" \"eslint.config.js\" \"playwright.config.js\"",
        "format:check": "prettier --check \".agents/skills/**/*.{md,mjs,yaml}\" \"audio/**/*.json\" \"audio-review/**/*.{js,json,md}\" \"manage/**/*.js\" \"shared/**/*.js\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.js\" \"tools/audio-review-console/*.{html,css,js}\" \".github/**/*.yml\" \"*.yml\" \"*.json\" \"eslint.config.js\" \"playwright.config.js\"",
        "test": "node scripts/test-static-server-range.js && node scripts/test-video-player.js && node scripts/test-game-records.js && node scripts/test-paper-cases.js && node scripts/test-audio-review-service.js && node scripts/test-audio-review-insights.mjs && node scripts/test-swipe-navigation.js && node scripts/test-storyline-routing.js && node scripts/test-cjk-tail-wrapping.js && node scripts/test-chronology-overview.js && node scripts/test-event-media-selection.js && node scripts/test-mobile-responsive.js && node scripts/test-analytics.js && node scripts/test-archive-authority.js && node scripts/test-content-tooling.js && node scripts/test-audio-storage.js && node scripts/test-audio-tooling.mjs && node scripts/test-admin-figure-management.js && node scripts/test-figure-registry.js && node scripts/test-event-figure-rules.js && node scripts/audit-ai100-locations.js && node scripts/audit-benchcouncil-ai100-annual.js && node scripts/audit-event-figures.js --check",
        "test:browser": "playwright test",
        "test:cjk-tail-wrapping": "node scripts/test-cjk-tail-wrapping.js",
        "quality": "npm run lint && npm run format:check && npm test",
        "verify:pr": "npm run validate:archive && npm run quality",
        "validate:startup": "node scripts/validate-startup.js",
        "validate:event-pack": "node scripts/validate-event-markdown-pack.js",
        "validate:archive": "node scripts/validate-archive.js && node scripts/validate-game-records.js && node scripts/validate-paper-cases.js",
        "validate:game-records": "node scripts/validate-game-records.js",
        "validate:paper-cases": "node scripts/validate-paper-cases.js",
        "migrate:figure-avatars": "node scripts/migrate-archive-figure-avatars.js",
        "report:figure-migration": "node scripts/migrate-figure-registry.js",
        "report:assets": "node scripts/report-assets-usage.js",
        "validate:ai100-context": "node scripts/validate-ai100-context.js",
        "validate:ai100-quizzes": "node scripts/validate-ai100-quizzes-grounded.js",
        "audit:ai100-membership": "node scripts/audit-benchcouncil-ai100-membership.js",
        "audit:ai100-annual": "node scripts/audit-benchcouncil-ai100-annual.js",
        "audit:ai100-contributors": "node scripts/audit-ai100-contributors.js",
        "audit:ai100-locations": "node scripts/audit-ai100-locations.js",
        "sync:ai100-contributors": "node scripts/sync-ai100-contributors.js",
        "sync:ai100-locations": "node scripts/sync-ai100-locations.js",
        "audit:ai100-accuracy": "node scripts/audit-ai100-accuracy.js",
        "audit:event-figure-rules": "node scripts/audit-event-figure-rules.js",
        "audit:figures": "node scripts/audit-event-figures.js",
        "audit:figures:check": "node scripts/audit-event-figures.js --check",
        "audit:svg-explainers": "node scripts/audit-svg-explainers.js",
        "audit:svg-geometry": "node scripts/run-svg-geometry-audit.js",
        "validate:deployment": "npm run validate:archive && npm run generate && npm run build:static && npm test && npm run validate:startup",
        "audio:release:dry-run": "node scripts/audio/audio-pipeline.mjs release push --dry-run"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@playwright/test": "^1.62.1",
        "ajv": "^8.20.0",
        "eslint": "^9.0.0",
        "prettier": "^3.0.0",
        "@aws-sdk/client-s3": "^3.1105.0",
        "@aws-sdk/lib-storage": "^3.1105.0"
    },
    "engines": {
        "node": ">=22"
    }
}
