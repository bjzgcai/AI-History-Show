    "turns": [
        {
            "role": "N",
            "text": "如果把「PaLM-E」拆开来看，真正改变研究方向的部分是什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "N",
            "text": "机器人学习系统往往使用任务专属策略，而大语言模型已经展示跨文本任务的广泛迁移。PaLM-E 追问：能否把传感器观察直接送入语言模型，让具身任务共享同一个通用推理基础。",
            "sourceIds": ["source-primary-record"],
            "claimIds": [
                "claim-annual-membership",
                "claim-publication-record",
                "claim-contributor-record",
                "claim-multimodal-sentence",
                "claim-positive-transfer"
            ],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "A",
            "text": "这听起来像一个漂亮的方向。真正让它运转起来的核心机制是什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "图像与机器人状态被编码为连续嵌入，并与普通文本 token 一起组成多模态句子。语言模型随后预测文本形式的答案、计划或高层决策，联合训练则混合机器人、视觉语言和纯语言任务。",
            "sourceIds": ["source-primary-record"],
            "claimIds": [
                "claim-annual-membership",
                "claim-publication-record",
                "claim-contributor-record",
                "claim-multimodal-sentence",
                "claim-positive-transfer"
            ],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "N",
            "text": "专家通常把 PaLM-E 视为具身 AI 与多模态语言建模之间较早的大规模桥梁。它证明机器人观察与网络规模通用知识可以共存于同一个序列模型中，并影响了后来的视觉语言动作系统。",
            "sourceIds": ["source-primary-record"],
            "claimIds": [
                "claim-annual-membership",
                "claim-publication-record",
                "claim-contributor-record",
                "claim-multimodal-sentence",
                "claim-positive-transfer"
            ],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
            "role": "N",
            "text": "回看「LLaVA」，再看「PaLM-E」，我们能听见同一个技术问题跨越年代后的回响。",
