    "turns": [
        {
            "role": "N",
            "text": "为什么「ReLU」会成为人工智能史上值得单独记住的一步？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "N",
            "text": "1969 年，福岛邦彦在 NHK 的多层神经网络研究中使用了后来被称为 ReLU 的整流响应，但这一思路当时没有得到广泛采用。2010—2011 年的系统实验重新验证了整流单元在深层网络中的训练优势，并推动其成为常用激活函数。",
            "sourceIds": [
                "source-fukushima-analog-threshold-elements",
                "source-rectified-linear-units-improve-restricted-boltzmann-machines",
                "source-deep-sparse-rectifier-neural-networks"
            ],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "N",
            "text": "负响应被截断为零，正响应则线性通过。",
            "sourceIds": ["source-deep-sparse-rectifier-neural-networks"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "N",
            "text": "专家通常把 ReLU 视为一个简单工程选择，但它的影响远大于公式本身。它的长期影响在于非饱和激活模式帮助深层网络更可靠地训练，并成为现代架构的默认组件。",
            "sourceIds": ["source-deep-sparse-rectifier-neural-networks"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
            "role": "N",
            "text": "当今天的系统规模越来越大时，「ReLU」留下的思路还有哪些价值，又有哪些边界值得重新追问？",
            "sourceIds": [
                "source-fukushima-analog-threshold-elements",
                "source-deep-sparse-rectifier-neural-networks",
                "source-rectified-linear-units-improve-restricted-boltzmann-machines",
                "source-yoshua-bengio-profile-at-mila",
                "source-candc-2021-kunihiko-fukushima"
            ],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "editorial-closing"
        }
    ]
