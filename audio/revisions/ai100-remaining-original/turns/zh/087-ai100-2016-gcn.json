    "turns": [
        {
            "role": "N",
            "text": "如果把「GCN」拆开来看，真正改变研究方向的部分是什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "N",
            "text": "GCN 提供了一个简单有效的层，用于同时从图结构和节点特征中学习。它成为半监督节点分类和图表示学习的标准基线。",
            "sourceIds": ["source-semi-supervised-classification-with-graph-convolutional-networks"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "A",
            "text": "这听起来像一个漂亮的方向。真正让它运转起来的核心机制是什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "节点特征通过归一化图邻域进行聚合，并转换为类别预测。",
            "sourceIds": ["source-semi-supervised-classification-with-graph-convolutional-networks"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "N",
            "text": "专家通常把 GCN 视为让图神经网络进入更广泛机器学习社群的模型。它的长期影响在于归一化邻居聚合层成为后续图模型的参照点。",
            "sourceIds": ["source-semi-supervised-classification-with-graph-convolutional-networks"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
            "role": "N",
            "text": "回看「图神经网络」，再看「GCN」，我们能听见同一个技术问题跨越年代后的回响。",
