    "turns": [
        {
            "role": "A",
            "text": "把时间拨回1984年，「Cyc 常识知识库」究竟在解决一个什么样的难题？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "B",
            "text": "专家系统能在狭窄领域工作，但缺少日常背景知识时很容易崩溃。",
            "sourceIds": ["source-building-large-knowledge-based-systems"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "A",
            "text": "这听起来像一个漂亮的方向。真正让它运转起来的核心机制是什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "Cyc 把事实与规则组织为带上下文微理论的本体，并用推理在该结构上回答问题。 关键机制是大型符号本体与微理论，它把资料线索与可见的演示行为连接起来。",
            "sourceIds": ["source-building-large-knowledge-based-systems"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "A",
            "text": "那它为什么没有停留在一篇论文或一次实验里？后来研究者真正继承了什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "专家通常把 Cyc 视为最雄心勃勃的符号 AI 尝试之一，目标是显式编码常识。它的长期影响在于持续推动关于知识工程、混合推理、本体和纯数据学习局限性的讨论。",
            "sourceIds": ["source-building-large-knowledge-based-systems"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
            "role": "SUMMARY",
            "text": "「Cyc 常识知识库」留下的关键，不只是一项成果，而是一种后来可以继续检验、改造和扩展的方法。",
            "sourceIds": [
                "source-the-evolution-of-cycl",
                "source-cyc",
                "source-cyc-projects-logo-image",
                "source-building-large-knowledge-based-systems"
            ],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "editorial-closing"
        }
    ]
