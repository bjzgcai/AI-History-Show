    "turns": [
        {
            "role": "N",
            "text": "如果把「Word2Vec」拆开来看，真正改变研究方向的部分是什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "N",
            "text": "Word2Vec 之前，许多 NLP 系统依赖稀疏计数或手工特征。Word2Vec 让密集向量在网页规模上变得实用。",
            "sourceIds": ["source-efficient-estimation-of-word-representations-in-vector-space"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "A",
            "text": "这听起来像一个漂亮的方向。真正让它运转起来的核心机制是什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "模型要么由词预测上下文，要么由上下文预测词，从而迫使相关词占据向量空间的相近区域。 关键机制是Skip-gram 与 CBOW 神经词嵌入，它把资料线索与可见的演示行为连接起来。",
            "sourceIds": ["source-efficient-estimation-of-word-representations-in-vector-space"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "N",
            "text": "专家通常把 Word2Vec 视为基础性的嵌入方法，它让分布式语义能够规模化运行。它的长期影响在于意义的几何观仍影响检索、表示学习和向量数据库。",
            "sourceIds": ["source-efficient-estimation-of-word-representations-in-vector-space"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
            "role": "N",
            "text": "回看「神经语言模型」，再看「Word2Vec」，我们能听见同一个技术问题跨越年代后的回响。",
            "sourceIds": [
                "source-distributed-representations-of-words-and-phrases-and-their-compositionality",
                "source-google-code-archive-word2vec",
                "source-efficient-estimation-of-word-representations-in-vector-space"
            ],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "editorial-closing"
        }
    ]
