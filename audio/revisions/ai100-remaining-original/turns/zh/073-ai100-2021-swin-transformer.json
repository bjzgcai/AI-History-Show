    "turns": [
        {
            "role": "A",
            "text": "上一段讲到「视觉 Transformer」。现在把镜头转向「Swin Transformer」，沿着这条故事线换一个问题：把时间拨回2021年，「Swin Transformer」究竟在解决一个什么样的难题？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "storyline-sequence"
        },
        {
            "role": "B",
            "text": "Swin Transformer 通过构建层级特征图并把自注意力限制在移位局部窗口内，把 Transformer 适配到密集视觉任务。这让 Transformer 骨干网络更适合需要多尺度特征的分类、检测和分割工作。",
            "sourceIds": ["source-swin-transformer-hierarchical-vision-transformer-using-shifted-windows"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "A",
            "text": "这听起来像一个漂亮的方向。真正让它运转起来的核心机制是什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "图像块被分组为窗口，注意力先在局部运行，移位窗口让相邻区域在层与层之间交换信息。",
            "sourceIds": ["source-swin-transformer-hierarchical-vision-transformer-using-shifted-windows"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "A",
            "text": "那它为什么没有停留在一篇论文或一次实验里？后来研究者真正继承了什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "专家通常把 Swin Transformer 视为让视觉 Transformer 超越图像分类并进入密集预测的重要一步。它的长期影响在于层级移位窗口设计被许多密集预测系统复用。",
            "sourceIds": ["source-swin-transformer-hierarchical-vision-transformer-using-shifted-windows"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
            "role": "SUMMARY",
            "text": "「Swin Transformer」留下的关键，不只是一项成果，而是一种后来可以继续检验、改造和扩展的方法。",
            "sourceIds": [
                "source-iccv-open-access-paper-page",
                "source-microsoft-swin-transformer-repository",
                "source-swin-transformer-hierarchical-vision-transformer-using-shifted-windows"
            ],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
