    "turns": [
        {
            "role": "A",
            "text": "把时间拨回1967年，「反向传播」究竟在解决一个什么样的难题？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "B",
            "text": "反向传播来自自适应控制和神经网络研究的多条线索，其中甘利俊一的自适应模式分类器以及 1986 年鲁梅尔哈特-辛顿-威廉姆斯论文成为核心参考。该方法能高效计算分层网络中的梯度。",
            "sourceIds": ["source-learning-representations-by-back-propagating-errors"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "A",
            "text": "这听起来像一个漂亮的方向。真正让它运转起来的核心机制是什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "输出误差沿网络反向求导，使每个权重获得更新量。",
            "sourceIds": ["source-learning-representations-by-back-propagating-errors"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "A",
            "text": "那它为什么没有停留在一篇论文或一次实验里？后来研究者真正继承了什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "专家通常把反向传播视为神经网络优化的核心工具，同时也承认它经历了多阶段重新发现。它的长期影响在于让深层表示能够大规模训练。",
            "sourceIds": ["source-learning-representations-by-back-propagating-errors"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
            "role": "SUMMARY",
            "text": "「反向传播」留下的关键，不只是一项成果，而是一种后来可以继续检验、改造和扩展的方法。",
