    "turns": [
        {
            "role": "A",
            "text": "一个看似专业的名字「Fast R-CNN」，背后藏着怎样一个直观问题？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "B",
            "text": "R-CNN 的检测精度很高，但需要对数千个候选区域分别运行卷积网络。Fast R-CNN 重新组织计算，让昂贵的卷积骨干能够在整张图像上共享。",
            "sourceIds": ["source-2015-fast-r-cnn-primary", "source-benchcouncil-ai100-catalog"],
            "claimIds": ["claim-2015-fast-r-cnn-membership", "claim-2015-fast-r-cnn-description"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "A",
            "text": "这听起来像一个漂亮的方向。真正让它运转起来的核心机制是什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "图像只需处理一次得到特征图，RoI 池化再为每个候选区域提取固定尺寸特征。单个网络联合预测类别概率和修正后的边界框。",
            "sourceIds": ["source-2015-fast-r-cnn-primary"],
            "claimIds": ["claim-2015-fast-r-cnn-membership", "claim-2015-fast-r-cnn-description"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "A",
            "text": "那它为什么没有停留在一篇论文或一次实验里？后来研究者真正继承了什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "专家通常把 Fast R-CNN 视为连接 R-CNN 与完整区域候选网络的关键效率桥梁。共享特征和联合损失后来成为两阶段检测器的标准设计。",
            "sourceIds": ["source-2015-fast-r-cnn-primary", "source-2015-fast-r-cnn-secondary"],
            "claimIds": ["claim-2015-fast-r-cnn-membership", "claim-2015-fast-r-cnn-description"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
            "role": "SUMMARY",
            "text": "「Fast R-CNN」留下的关键，不只是一项成果，而是一种后来可以继续检验、改造和扩展的方法。",
            "sourceIds": [
                "source-2015-fast-r-cnn-primary",
                "source-2015-fast-r-cnn-secondary",
