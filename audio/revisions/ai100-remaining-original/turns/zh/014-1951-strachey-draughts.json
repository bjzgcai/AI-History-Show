    "turns": [
        {
            "role": "N",
            "text": "为什么「克里斯托弗·斯特雷奇 的跳棋程序」会成为人工智能史上值得单独记住的一步？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "N",
            "text": "在 1950 年代早期，运行一个非数值游戏程序会把极小内存和脆弱编程工具推到极限。",
            "sourceIds": ["source-logical-or-non-mathematical-programmes"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "N",
            "text": "该程序编码合法走法和棋盘评估，使机器能够选择行动，而不是只回放脚本。 关键机制是棋盘状态搜索与评估，它把资料线索与可见的演示行为连接起来。",
            "sourceIds": ["source-logical-or-non-mathematical-programmes"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "N",
            "text": "专家通常把斯特雷奇的跳棋程序视为早期证据，说明存储程序计算机可以尝试非数值对弈和选择。它的长期影响在于帮助把棋类游戏确立为研究搜索、评估和机器智能演示的受控环境。",
            "sourceIds": ["source-logical-or-non-mathematical-programmes"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
            "role": "N",
            "text": "当今天的系统规模越来越大时，「克里斯托弗·斯特雷奇 的跳棋程序」留下的思路还有哪些价值，又有哪些边界值得重新追问？",
            "sourceIds": [
                "source-logical-or-non-mathematical-programmes",
                "source-strachey-draughts-program-screenshot",
                "source-checkers-board-photo",
                "source-computer-pioneers-christopher-strachey"
            ],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "editorial-closing"
        }
    ]
}
