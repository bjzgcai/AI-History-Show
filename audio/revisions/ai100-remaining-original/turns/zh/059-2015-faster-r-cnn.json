    "turns": [
        {
            "role": "N",
            "text": "研究者为什么需要「Faster R-CNN」？当时已有的方法究竟卡在了哪里？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "N",
            "text": "R-CNN 已经大幅提升目标检测精度，但外部候选区域生成让流水线变慢且不够统一。",
            "sourceIds": ["source-faster-r-cnn-towards-real-time-object-detection-with-region-proposal-networks"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "N",
            "text": "Faster R-CNN 让网络在计算视觉特征的同时学习提出候选框。检测因此成为学习型流水线，而不是无关模块之间的交接。",
            "sourceIds": ["source-faster-r-cnn-towards-real-time-object-detection-with-region-proposal-networks"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "N",
            "text": "专家通常把 Faster R-CNN 视为让目标检测更端到端、更可学习的转折点。它的长期影响在于“候选区域 + 识别”框架仍塑造着研究者对精度、速度和定位权衡的解释。",
            "sourceIds": ["source-faster-r-cnn-towards-real-time-object-detection-with-region-proposal-networks"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
