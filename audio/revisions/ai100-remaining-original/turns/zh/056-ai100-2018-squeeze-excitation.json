    "turns": [
        {
            "role": "N",
            "text": "为什么「挤压与激励网络」会成为人工智能史上值得单独记住的一步？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "N",
            "text": "传统卷积网络通常把通道视为固定堆叠，但不同通道承载的语义信号并不相同。挤压与激励网络提出，模型是否可以针对每个输入动态重标定各通道的重要性。",
            "sourceIds": ["source-2018-squeeze-excitation-primary", "source-benchcouncil-ai100-catalog"],
            "claimIds": ["claim-2018-squeeze-excitation-membership", "claim-2018-squeeze-excitation-description"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "N",
            "text": "挤压操作对每个通道进行全局汇总，小型激励网络再预测逐通道门控权重。把这些权重乘回特征图后，网络可以增强有用通道并抑制较弱通道。",
            "sourceIds": ["source-2018-squeeze-excitation-primary"],
            "claimIds": ["claim-2018-squeeze-excitation-membership", "claim-2018-squeeze-excitation-description"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "N",
            "text": "专家通常认为通道注意力是一种简单而持久的架构思想，SE 模块后来成为 CNN 骨干网络中的常见组件。该成果也推动了“注意力不仅适用于序列模型”的认识。",
            "sourceIds": ["source-2018-squeeze-excitation-primary", "source-2018-squeeze-excitation-secondary"],
            "claimIds": ["claim-2018-squeeze-excitation-membership", "claim-2018-squeeze-excitation-description"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
            "role": "N",
            "text": "当今天的系统规模越来越大时，「挤压与激励网络」留下的思路还有哪些价值，又有哪些边界值得重新追问？",
            "sourceIds": [
                "source-2018-squeeze-excitation-primary",
                "source-2018-squeeze-excitation-secondary",
                "source-benchcouncil-ai100-catalog",
                "source-2018-squeeze-excitation-portrait"
            ],
            "claimIds": ["claim-2018-squeeze-excitation-membership", "claim-2018-squeeze-excitation-description"],
            "contentOrigin": "editorial-closing"
        }
    ]
