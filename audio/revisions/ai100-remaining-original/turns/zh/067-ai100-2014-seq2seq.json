    "turns": [
        {
            "role": "A",
            "text": "把时间拨回2014年，「序列到序列学习」究竟在解决一个什么样的难题？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "B",
            "text": "早期神经语言系统往往依赖任务专用流程和固定窗口。编码器—解码器模型提供了一种通用方法，可以把一个长度的输入序列映射为另一长度的输出序列。",
            "sourceIds": ["source-2014-seq2seq-primary", "source-benchcouncil-ai100-catalog"],
            "claimIds": ["claim-2014-seq2seq-membership", "claim-2014-seq2seq-description"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "A",
            "text": "这听起来像一个漂亮的方向。真正让它运转起来的核心机制是什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "编码器读取源序列并形成学习到的表示，解码器再逐词生成目标序列。训练目标是在给定输入的条件下最大化输出序列的条件概率。",
            "sourceIds": ["source-2014-seq2seq-primary"],
            "claimIds": ["claim-2014-seq2seq-membership", "claim-2014-seq2seq-description"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "A",
            "text": "那它为什么没有停留在一篇论文或一次实验里？后来研究者真正继承了什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "专家通常把序列到序列学习视为在注意力和 Transformer 之前推动端到端神经机器翻译走向实用的关键架构。它也扩展到摘要、对话、解析等结构化生成任务。",
            "sourceIds": ["source-2014-seq2seq-primary", "source-2014-seq2seq-secondary"],
            "claimIds": ["claim-2014-seq2seq-membership", "claim-2014-seq2seq-description"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
            "role": "SUMMARY",
            "text": "「序列到序列学习」留下的关键，不只是一项成果，而是一种后来可以继续检验、改造和扩展的方法。",
            "sourceIds": [
                "source-2014-seq2seq-primary",
                "source-2014-seq2seq-secondary",
                "source-benchcouncil-ai100-catalog",
                "source-2014-seq2seq-portrait"
            ],
