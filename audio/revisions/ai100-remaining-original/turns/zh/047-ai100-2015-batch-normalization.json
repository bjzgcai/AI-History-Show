    "turns": [
        {
            "role": "N",
            "text": "研究者为什么需要「批归一化」？当时已有的方法究竟卡在了哪里？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "N",
            "text": "批归一化通过在小批量学习中归一化中间激活值来稳定深度网络训练。它让更高学习率和更深网络在实践中更容易使用。",
            "sourceIds": ["source-batch-normalization"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "N",
            "text": "激活值在网络内部先居中和缩放，再由学习参数进行平移。",
            "sourceIds": ["source-batch-normalization"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "N",
            "text": "专家通常把批归一化视为实用的训练稳定器，同时也指出后来的架构有时会用其他归一化方法替代它。它的长期影响在于把激活统计量明确纳入深度网络优化过程。",
            "sourceIds": ["source-batch-normalization"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
            "role": "N",
            "text": "这条线索还没有结束。接下来来到「新认知机」，我们会看到研究者怎样把问题继续向前推进。",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "storyline-sequence"
        }
    ]
