    "turns": [
        {
            "role": "A",
            "text": "一个看似专业的名字「时序差分更新」，背后藏着怎样一个直观问题？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "B",
            "text": "从延迟奖励中学习需要一种在整个回合结束前分配信用的方法。",
            "sourceIds": ["source-learning-to-predict-by-the-methods-of-temporal-differences"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "A",
            "text": "这听起来像一个漂亮的方向。真正让它运转起来的核心机制是什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "TD 比较当前预测与“奖励加下一步预测”，再把当前价值向该目标推进。 关键机制是自举式价值预测，它把资料线索与可见的演示行为连接起来。",
            "sourceIds": ["source-learning-to-predict-by-the-methods-of-temporal-differences"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "A",
            "text": "那它为什么没有停留在一篇论文或一次实验里？后来研究者真正继承了什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "专家通常把时序差分学习视为强化学习的基石。它的长期影响在于提出价值估计可以从后续预测中自举学习，并支撑了 Q-learning、actor-critic 方法和现代基于价值的控制。",
            "sourceIds": ["source-learning-to-predict-by-the-methods-of-temporal-differences"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
            "role": "SUMMARY",
            "text": "「时序差分更新」留下的关键，不只是一项成果，而是一种后来可以继续检验、改造和扩展的方法。",
