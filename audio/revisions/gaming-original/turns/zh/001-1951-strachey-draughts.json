    "turns": [
        {
            "role": "N",
            "text": "为什么「克里斯托弗·斯特雷奇 的跳棋程序」会成为人工智能史上值得单独记住的一步？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "N",
            "text": "在 1950 年代早期，电子计算机主要被视为数值计算设备，内存容量和编程工具也极其有限。在这种条件下实现跳棋，意味着机器必须表示棋盘、生成合法走法并在有限资源内比较候选行动。",
            "sourceIds": ["source-logical-or-non-mathematical-programmes"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "N",
            "text": "程序把合法走法生成、局面评估和有限前瞻组合起来，使机器能够根据当前棋盘选择行动，而不是只回放预先写好的脚本。这个结构已经包含后来许多博弈程序反复使用的基本循环：生成、搜索、评估和选择。",
            "sourceIds": ["source-logical-or-non-mathematical-programmes"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "N",
            "text": "专家通常把斯特雷奇的跳棋程序视为早期证据，说明存储程序计算机可以尝试非数值对弈和选择。它的长期影响在于帮助把棋类游戏确立为研究搜索、评估和机器智能演示的受控环境。",
            "sourceIds": ["source-logical-or-non-mathematical-programmes"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
            "role": "N",
            "text": "当今天的系统规模越来越大时，「克里斯托弗·斯特雷奇 的跳棋程序」留下的思路还有哪些价值，又有哪些边界值得重新追问？",
            "sourceIds": [
                "source-logical-or-non-mathematical-programmes",
                "source-strachey-draughts-program-screenshot",
                "source-checkers-board-photo"
            ],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "editorial-closing"
        }
    ]
}
