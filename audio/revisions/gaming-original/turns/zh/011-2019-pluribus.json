    "turns": [
        {
            "role": "N",
            "text": "研究者为什么需要「Pluribus」？当时已有的方法究竟卡在了哪里？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "N",
            "text": "许多真实策略场景并不是干净的两人零和棋局。多人扑克通过多个拥有私人信息、激励不断变化的对手，把这个差距具体化了。",
            "sourceIds": ["source-science-paper"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "N",
            "text": "Pluribus 使用紧凑自我对弈蓝图作为基准策略。在对局中，它用有限前瞻搜索细化决策，而不是从头求解整个六人游戏。",
            "sourceIds": ["source-science-paper"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "N",
            "text": "专家通常把 Pluribus 视为不完全信息 AI 扩展到两人之外的重要展示。它的长期影响在于提出蓝图加搜索模式，用于那些无法精确计算均衡的复杂多智能体领域。",
            "sourceIds": ["source-science-paper"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
