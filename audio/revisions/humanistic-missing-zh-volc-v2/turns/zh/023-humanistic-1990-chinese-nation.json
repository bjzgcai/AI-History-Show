    "turns": [
        {
            "role": "N",
            "text": "1978年，布洛克的中华民族（Chinese Nation）进入了人工智能与人文想象的历史。它提出了怎样的问题，又为什么值得我们今天重新回看？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "N",
            "text": "布洛克在 1978 年有关功能主义的论文中提出这类“中华民族”或“中国脑”思想实验。功能主义认为，只要系统内部因果角色与人脑相同，构成材料不同也可以具有同类心智状态。",
            "sourceIds": ["source-humanistic-1990-chinese-nation-record"],
            "claimIds": ["claim-humanistic-1990-chinese-nation-core"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "A",
            "text": "这听起来像一个有吸引力的方向。真正让它成立的核心思想是什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "思想实验让每个人承担一个神经元的功能，通过通信设备共同控制机器人身体。布洛克借直觉上的反差追问：即使整体输入输出和内部功能关系都与人脑对应，我们是否愿意说整个国家形成了一个具有体验的意识。",
            "sourceIds": ["source-humanistic-1990-chinese-nation-record"],
            "claimIds": ["claim-humanistic-1990-chinese-nation-core"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "N",
            "text": "心灵哲学家通常把它视为反对简单功能主义的重要思想实验，并常与中文房间、哲学僵尸和系统回应并列讨论。它对 AI 的意义在于区分行为能力、功能组织和主观体验，提醒人们这些判断标准并不天然等价。",
            "sourceIds": ["source-humanistic-1990-chinese-nation-record"],
            "claimIds": ["claim-humanistic-1990-chinese-nation-core"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
            "role": "N",
            "text": "回看《计算机不能做什么》，再看布洛克的中华民族（Chinese Nation），我们能听见同一个关于机器与人的问题跨越年代后的历史回响。",
            "sourceIds": ["source-humanistic-1990-chinese-nation-record"],
            "claimIds": ["claim-humanistic-1990-chinese-nation-core"],
            "contentOrigin": "editorial-closing"
        }
    ]
}
