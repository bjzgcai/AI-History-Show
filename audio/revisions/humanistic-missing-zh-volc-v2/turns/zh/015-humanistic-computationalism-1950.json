    "turns": [
        {
            "role": "A",
            "text": "20世纪中叶，计算主义进入了人工智能与人文想象的历史。它提出了怎样的问题，又为什么值得我们今天重新回看？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-hook"
        },
        {
            "role": "B",
            "text": "计算主义把认知过程理解为信息处理或计算操作，主张心智与大脑的关系可以通过功能和程序来说明，为机器能否拥有心智提供理论基础。",
            "sourceIds": ["source-humanistic-computationalism-1950-record"],
            "claimIds": ["claim-humanistic-computationalism-1950-core"],
            "contentOrigin": "commentarySections.historical-background"
        },
        {
            "role": "A",
            "text": "这听起来像一个有吸引力的方向。真正让它成立的核心思想是什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "作品或理论把人工制造、自动行动或计算过程转化为对主体性、理解与社会秩序的追问。",
            "sourceIds": ["source-humanistic-computationalism-1950-record"],
            "claimIds": ["claim-humanistic-computationalism-1950-core"],
            "contentOrigin": "commentarySections.core-idea"
        },
        {
            "role": "A",
            "text": "那它为什么没有停留在一次作品、实验或争论里？后来人们真正继承了什么？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial"
        },
        {
            "role": "B",
            "text": "研究者通常把这一节点视为 AI 人文史中的重要文化参照，而不是现代技术的直接预言。",
            "sourceIds": ["source-humanistic-computationalism-1950-record"],
            "claimIds": ["claim-humanistic-computationalism-1950-core"],
            "contentOrigin": "commentarySections.long-term-legacy"
        },
        {
            "role": "A",
            "text": "当今天的人工智能越来越深入生活时，计算主义留下的哪些问题仍然没有答案？我们又该如何重新检验它关于机器与人的判断？",
            "sourceIds": ["source-humanistic-computationalism-1950-record"],
            "claimIds": ["claim-humanistic-computationalism-1950-core"],
            "contentOrigin": "editorial-closing"
        }
