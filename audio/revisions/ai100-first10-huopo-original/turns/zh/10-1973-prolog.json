    "turns": [
        {
            "role": "A",
            "text": "LISP 把代码和数据都装进列表，Prolog 则让程序看起来更像一组事实和规则。机器会怎样把查询变成证明？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-revision"
        },
        {
            "role": "B",
            "text": "阿兰·科尔梅罗尔及其马赛团队在 1970 年代初开发 Prolog，并受到罗伯特·科瓦尔斯基逻辑程序设计思想的影响。程序由事实和规则组成，用户提出查询后，系统通过合一匹配变量，并沿规则建立证明；当路径失败时，它回溯到较早选择继续搜索。",
            "sourceIds": ["source-the-birth-of-prolog"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "variant.displayDescription.background"
        },
        {
            "role": "A",
            "text": "如果程序员主要描述关系，机器具体怎样找到答案？",
            "sourceIds": [],
            "claimIds": [],
            "contentOrigin": "editorial-revision"
        },
        {
            "role": "B",
            "text": "这种声明式方式让程序员主要描述“哪些关系成立”，而把部分执行顺序交给推理引擎。Prolog 很快用于自然语言处理、专家系统、定理证明和知识表示，也暴露了搜索顺序和控制策略对实际性能的重要性。它证明逻辑不只是说明语言，也可以成为可运行的程序设计基础。",
            "sourceIds": ["source-the-birth-of-prolog"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "variant.displayDescription.explanation"
        },
        {
            "role": "B",
            "text": "Prolog 最特别的地方，是把写程序变成描述关系，再把寻找答案交给合一与回溯。逻辑因此从纸面规则变成了可以运行的计算过程。",
            "sourceIds": ["source-prolog-heritage", "source-swi-prolog-documentation", "source-the-birth-of-prolog"],
            "claimIds": ["claim-legacy-achievement-summary", "claim-legacy-description"],
            "contentOrigin": "editorial-closing-revision"
        }
    ]
}
